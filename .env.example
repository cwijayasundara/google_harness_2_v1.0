# Only the host inference gateway reads this key. Never commit a real credential.
FIREWORKS_API_KEY=
# Paid calls are disabled unless --max-usd is explicitly nonzero.
# eToro Public API (read-only). Both keys come from api-portal.etoro.com -> API Key Management.
# Only needed to fetch the portfolio without --csv. Export them in your shell.
ETORO_API_KEY=
ETORO_USER_KEY=
# real (default) or demo; each eToro key works for one environment.
ETORO_ENVIRONMENT=real
